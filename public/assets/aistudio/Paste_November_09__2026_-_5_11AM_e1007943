<!-- NOTIFICATION TOAST PERSONNALISÉE -->
<div class="fixed bottom-6 right-6 z-50 hidden items-center gap-3 px-5 py-3.5 rounded-xl bg-navy-900 border border-gold-400 text-white shadow-2xl" id="toast">
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check-circle" aria-hidden="true" class="lucide lucide-check-circle w-5 h-5 text-emerald-400 shrink-0"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg>
<span class="text-sm font-medium" id="toastMessage"></span>
</div>
<script>
        // Initialisation des icônes Lucide
        lucide.createIcons();

        // Gestion du menu mobile
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Données des formalités KYANOT pour feedback instantané
        const formalitesData = {
            immobilier: {
                title: "Immobilier & Foncier (Vente / Acquisition / ACD)",
                fee: "Frais de pré-instruction : 35 000 FCFA",
                docs: "Pièces à préparer : Copie CNI/Passeport de l'acquéreur et vendeur, Titre de propriété (ACD, CMP ou lettre d'attribution), plan de situation cadastral et certificat de localisation."
            },
            societe: {
                title: "Constitution de Société (SARL / SAS / SA)",
                fee: "Frais de pré-instruction : 30 000 FCFA",
                docs: "Pièces à préparer : Pièces d'identité des associés et gérants, projet de dénomination sociale, justificatif de siège social, déclaration de souscription de capital."
            },
            procuration: {
                title: "Procuration Authentique Notariée",
                fee: "Frais de pré-instruction : 20 000 FCFA",
                docs: "Pièces à préparer : CNI du mandant et du mandataire, motif détaillé et portée du pouvoir confié (bancaire, foncier, représentation)."
            },
            succession: {
                title: "Règlement de Succession & Partage",
                fee: "Frais de pré-instruction : 40 000 FCFA",
                docs: "Pièces à préparer : Extrait d'acte de décès du défunt, livret de famille, actes de naissance des héritiers, inventaire des titres de biens et comptes bancaires."
            },
            donation: {
                title: "Donation entre Vifs",
                fee: "Frais de pré-instruction : 35 000 FCFA",
                docs: "Pièces à préparer : CNI du donateur et du donataire, titres de propriété des biens donnés, lien de parenté certifié."
            },
            famille: {
                title: "Contrat de Mariage & Actes de Famille",
                fee: "Frais de pré-instruction : 25 000 FCFA",
                docs: "Pièces à préparer : Extraits de naissance des futurs époux (< 3 mois), CNI/Passeports, choix du régime matrimonial (séparation de biens ou communauté réduite)."
            },
            autre: {
                title: "Autre formalité notariale",
                fee: "Frais de pré-instruction : 25 000 FCFA",
                docs: "Veuillez préciser la nature de votre acte dans votre dossier. Nos clercs vous indiqueront la liste précise."
            }
        };

        function updateFormaliteDetails() {
            const select = document.getElementById('formaliteSelect');
            const val = select.value;
            const box = document.getElementById('formaliteDynamicBox');
            if (!val || !formalitesData[val]) {
                box.classList.add('hidden');
                return;
            }
            document.getElementById('dynFormaliteTitle').textContent = formalitesData[val].title;
            document.getElementById('dynFormaliteFee').textContent = formalitesData[val].fee;
            document.getElementById('dynFormaliteDocs').textContent = formalitesData[val].docs;
            box.classList.remove('hidden');
        }

        function selectCardFormalite(key) {
            const select = document.getElementById('formaliteSelect');
            select.value = key;
            updateFormaliteDetails();
            document.getElementById('formaliteSelect').scrollIntoView({ behavior: 'smooth', block: 'center' });
            document.getElementById('modalFormaliteSelect').value = key;
        }

        function prefillKyanot() {
            document.getElementById('kyanot').scrollIntoView({ behavior: 'smooth' });
        }

        // Détails des domaines d'expertise
        const servicesData = {
            famille: {
                title: "Droit de la Famille & Successions — Préserver l'harmonie entre les générations",
                text: "Qu'il s'agisse de choisir votre régime matrimonial, de rédiger un testament incontestable, d'organiser une donation de votre vivant ou de régler une succession avec équité, Maître KOFFI Yassoua Alain veille à protéger vos proches et à prévenir tout litige familial."
            },
            immobilier: {
                title: "Immobilier & Patrimoine — Sécuriser chaque mètre carré en Côte d'Ivoire",
                text: "Face à la multiplication des fraudes foncières sur Internet, l'intervention du Notaire est obligatoire et salvatrice : vérification préalable de l'ACD et de l'état foncier, rédaction de l'acte authentique de vente, sécurisation des fonds et publication officielle."
            },
            affaires: {
                title: "Droit des Affaires & Sociétés — Accompagner les entrepreneurs et investisseurs",
                text: "Constitution rapide de sociétés (SARL, SA, SAS selon les normes OHADA), rédaction de pactes d'associés, cessions de parts sociales, baux à usage professionnel et authentification de vos accords stratégiques."
            }
        };

        function showServiceDetail(key) {
            const box = document.getElementById('serviceDetailBox');
            const title = document.getElementById('serviceDetailTitle');
            const text = document.getElementById('serviceDetailText');
            title.textContent = servicesData[key].title;
            text.textContent = servicesData[key].text;
            box.classList.remove('hidden');
        }

        // Modales
        function openModal(id) {
            const modal = document.getElementById(id);
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            lucide.createIcons();
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // Gestion de formulaire direct KYANOT
        function handleKyanotSubmit(e) {
            e.preventDefault();
            const formalite = document.getElementById('formaliteSelect').value;
            const tel = document.getElementById('kyanotTel').value;
            if(!formalite) {
                showToast("Veuillez sélectionner un type de formalité.");
                return;
            }
            document.getElementById('modalFormaliteSelect').value = formalite;
            openModal('kyanotModal');
        }

        // Gestion upload fichier simulé
        function handleFileSelected(input) {
            const list = document.getElementById('fileUploadList');
            if (input.files.length > 0) {
                list.innerHTML = `<strong>${input.files.length} document(s) sélectionné(s) :</strong> ` + 
                    Array.from(input.files).map(f => f.name).join(', ');
                list.classList.remove('hidden');
            }
        }

        // Soumission KYANOT
        function submitKyanotDossier(e) {
            e.preventDefault();
            const provider = document.querySelector('input[name="momo_provider"]:checked')?.value || "Mobile Money";
            closeModal('kyanotModal');
            e.target.reset();
            document.getElementById('fileUploadList').classList.add('hidden');
            showToast(`Dossier KYANOT pré-enregistré ! Paiement de pré-instruction initié via ${provider}. Notification envoyée par SMS.`);
        }

        // Soumission RDV
        function submitRdv(e) {
            e.preventDefault();
            closeModal('rdvModal');
            e.target.reset();
            showToast("Votre demande de rendez-vous a bien été enregistrée. L'Étude de Me KOFFI vous recontactera très rapidement.");
        }

        // Copie contact
        function copyContact(textToCopy, successMessage) {
            const tempInput = document.createElement('textarea');
            tempInput.value = textToCopy;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            showToast(successMessage);
        }

        // Téléchargement vCard
        function downloadVCard() {
            const vcard = [
                "BEGIN:VCARD",
                "VERSION:3.0",
                "N:KOFFI;Yassoua Alain;;Me;",
                "FN:Me KOFFI Yassoua Alain - Notaire",
                "ORG:Étude de Me KOFFI Yassoua Alain",
                "TITLE:Notaire",
                "TEL;TYPE=CELL,VOICE:+2250709341341",
                "TEL;TYPE=WORK,VOICE:+22521243724",
                "EMAIL;TYPE=PREF,INTERNET:kyanot@aviso.ci",
                "EMAIL;TYPE=INTERNET:kyanot.etudemaitrekoffi@gmail.com",
                "ADR;TYPE=WORK:;;Bd. VGE - Immeuble Balance (face Solibra) - 30 B.P. 524;Abidjan;;30;Côte d'Ivoire",
                "URL:https://kyanot.notaire.ci",
                "END:VCARD"
            ].join("\n");

            const blob = new Blob([vcard], { type: "text/vcard;charset=utf-8" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = "Me_KOFFI_Yassoua_Alain_Notaire_KYANOT.vcf";
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast("Carte de visite digitale (vCard) téléchargée !");
        }

        // Toast
        let toastTimeout;
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            toastMessage.textContent = message;
            toast.classList.remove('hidden');
            toast.classList.add('flex');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('hidden');
                toast.classList.remove('flex');
            }, 4500);
        }
    </script>




</body></html>